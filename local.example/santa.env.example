# Copy to local/santa.env and uncomment what you want to change. One KEY=VALUE per line.
# The common settings only; every setting, with its default, is in docs/configuration.md.
# A value set in your shell wins over this file. Read by `python -m santa.web`, `chat.py` and scripts/start-santa.sh.
# Read when Santa starts: restart Santa after editing this file.

# --- Home network mode (python -m santa.web --network)
# SANTA_PIN=           # required for --network (6+ characters); other devices enter it, this Mac never does
# SANTA_PORT=8765
# SANTA_ALERTS=1       # macOS security alert with a Stop Santa button (0 = off)
# SANTA_GATE_LIMIT=10  # PIN tries per minute from devices that have not entered the PIN (all together)
# SANTA_ALLOWED_HOSTS= # extra names the server answers to, comma-separated (e.g. santa.home)

# --- Voice
# SANTA_TTS=kokoro     # or: pocket
# SANTA_VOICE=am_michael
# SANTA_SPEED=0.9

# --- Behaviour (1 = on, 0 = off)
# SANTA_HO_ONCE=1      # "Ho ho ho" only when answering, or after a child's song or joke
# SANTA_GENTLE=1
# SANTA_CALL_SUMMARY=1  # save a one-line "Last call" fact per child at Hang up
# SANTA_GIFT_ASK=1
# SANTA_GIFT_ASK_TURN=5
# SANTA_SONGS=1
# SANTA_TIME_NOTE=1
# SANTA_ARC=0

# --- Listening
# SANTA_EOS_MS=1200    # how long a pause ends the child's turn (ms)
# SANTA_EOS_EXTEND=1   # wait once up to 1800 ms after a short turn (0 = off)
# SANTA_STT_MODEL=mlx-community/whisper-small.en-mlx

# --- Model
# SANTA_MODEL=ai/gemma4:e4b
# SANTA_BASE_URL=http://localhost:12434/engines/v1   # the children's words go to whatever server you name
# SANTA_FILTER=prefix  # "legacy" switches to the alternative output filter

# Note: SANTA_LOCAL_DIR (where this folder lives) must be set in the shell, not here.
